generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id        String          @id @default(uuid())
  name      String
  level     String
  goal      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  
  progress    ProgressEntry[]
  weeklyPlan  DailyWorkout[]
}

model ProgressEntry {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  weight    Float
  chest     Float?
  arm       Float?
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model DailyWorkout {
  id        String   @id @default(uuid())
  day       String   // e.g., 'Segunda', 'Terça'
  title     String
  focus     String[] // PostgreSQL array of strings
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  exercises DailyWorkoutExercise[]
}

model DailyWorkoutExercise {
  id           String       @id @default(uuid())
  workoutId    String
  workout      DailyWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId   String       // Links to static EXERCISES from lib/data.ts
  sets         Int
  reps         String
  restSeconds  Int
}
